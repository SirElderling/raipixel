    "check": {"enum":["structure","dimensions","palette","alpha","bounds","animation","registration","metadata"]},
    "checks": {"type":"array","items":{"$ref":"#/$defs/check"},"minItems":0,"maxItems":8,"uniqueItems":true},
    "singleChar": {"type":"string","pattern":"^[ -~]$"},
    "op_asset_create": {"type":"object","properties":{"op":{"const":"asset.create"},"name":{"$ref":"#/$defs/name"},"size":{"$ref":"#/$defs/size"},"pivot":{"$ref":"#/$defs/point"},"palette":{"anyOf":[{"$ref":"#/$defs/name"},{"type":"null"}]},"style":{"anyOf":[{"$ref":"#/$defs/name"},{"type":"null"}]}},"required":["op","name","size"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_asset_clone": {"type":"object","properties":{"op":{"const":"asset.clone"},"source":{"$ref":"#/$defs/name"},"name":{"$ref":"#/$defs/name"}},"required":["op","source","name"],"additionalProperties":false,"x-priority":"Core"},
    "op_asset_set": {"type":"object","properties":{"op":{"const":"asset.set"},"asset":{"$ref":"#/$defs/name"},"pivot":{"$ref":"#/$defs/point"},"palette":{"anyOf":[{"$ref":"#/$defs/name"},{"type":"null"}]},"style":{"anyOf":[{"$ref":"#/$defs/name"},{"type":"null"}]}},"required":["op","asset"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_layer_create": {"type":"object","properties":{"op":{"const":"layer.create"},"asset":{"$ref":"#/$defs/name"},"name":{"$ref":"#/$defs/name"},"visible":{"type":"boolean"},"opacity":{"type":"integer","minimum":0,"maximum":255}},"required":["op","asset","name"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_layer_set": {"type":"object","properties":{"op":{"const":"layer.set"},"target":{"$ref":"#/$defs/ref2"},"visible":{"type":"boolean"},"opacity":{"type":"integer","minimum":0,"maximum":255},"order":{"type":"integer","minimum":0,"maximum":255}},"required":["op","target"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_frame_create": {"type":"object","properties":{"op":{"const":"frame.create"},"asset":{"$ref":"#/$defs/name"},"name":{"$ref":"#/$defs/name"},"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"source":{"$ref":"#/$defs/name"}},"required":["op","asset","name"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_frame_set": {"type":"object","properties":{"op":{"const":"frame.set"},"target":{"$ref":"#/$defs/ref2"},"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"order":{"type":"integer","minimum":0,"maximum":4095}},"required":["op","target"],"additionalProperties":false,"x-priority":"Core"},
    "op_cel_create": {"type":"object","properties":{"op":{"const":"cel.create"},"target":{"$ref":"#/$defs/cel"},"size":{"$ref":"#/$defs/size"},"offset":{"$ref":"#/$defs/point"},"source":{"$ref":"#/$defs/cel"},"replace":{"type":"boolean"}},"required":["op","target"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_cel_offset": {"type":"object","properties":{"op":{"const":"cel.offset"},"targets":{"$ref":"#/$defs/targets"},"at":{"$ref":"#/$defs/point"}},"required":["op","targets","at"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_png_import": {"type":"object","properties":{"op":{"const":"png.import"},"target":{"$ref":"#/$defs/cel"},"file":{"type":"string","maxLength":65536},"offset":{"$ref":"#/$defs/point"},"replace":{"type":"boolean"}},"required":["op","target","file"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_grid": {"type":"object","properties":{"op":{"const":"grid"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"at":{"$ref":"#/$defs/point"},"rows":{"type":"array","items":{"type":"string","pattern":"^[ -~]+$","maxLength":4096},"minItems":1,"maxItems":4096},"symbols":{"type":"object","propertyNames":{"$ref":"#/$defs/singleChar"},"additionalProperties":{"$ref":"#/$defs/color"},"maxProperties":95},"skip":{"$ref":"#/$defs/singleChar"},"mode":{"enum":["copy","over"]}},"required":["op","targets","rows","symbols"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_draw": {"type":"object","properties":{"op":{"const":"draw"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"shape":{"enum":["pixel","line","rect","ellipse","polygon"]},"color":{"$ref":"#/$defs/color"},"at":{"$ref":"#/$defs/point"},"points":{"type":"array","items":{"$ref":"#/$defs/point"},"minItems":2,"maxItems":4096},"rect":{"$ref":"#/$defs/rect"},"filled":{"type":"boolean"},"mode":{"enum":["copy","over"]}},"required":["op","targets","shape","color"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_fill": {"type":"object","properties":{"op":{"const":"fill"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"at":{"$ref":"#/$defs/point"},"color":{"$ref":"#/$defs/color"},"mode":{"enum":["copy","over"]}},"required":["op","targets","at","color"],"additionalProperties":false,"x-priority":"Foundation"},
