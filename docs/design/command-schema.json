    "op_palette_extract": {"type":"object","properties":{"op":{"const":"palette.extract"},"source":{"$ref":"#/$defs/cel"},"name":{"$ref":"#/$defs/name"},"max_colors":{"type":"integer","minimum":1,"maximum":256}},"required":["op","source","name"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_palette_map": {"type":"object","properties":{"op":{"const":"palette.map"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"pairs":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/literal"},"minItems":2,"maxItems":2},"minItems":1,"maxItems":256},"preserve_alpha":{"type":"boolean"}},"required":["op","targets","pairs"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_palette_quantize": {"type":"object","properties":{"op":{"const":"palette.quantize"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"palette":{"$ref":"#/$defs/name"},"dither":{"enum":["none"]}},"required":["op","targets","palette"],"additionalProperties":false,"x-priority":"Core"},
    "op_alpha": {"type":"object","properties":{"op":{"const":"alpha"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"kind":{"enum":["key","threshold"]},"threshold":{"type":"integer","minimum":0,"maximum":255},"color":{"$ref":"#/$defs/color"},"match":{"enum":["rgb","rgba"]}},"required":["op","targets","kind"],"additionalProperties":false,"x-priority":"Foundation/Core"},
    "op_mask_create": {"type":"object","properties":{"op":{"const":"mask.create"},"source":{"$ref":"#/$defs/cel"},"target":{"$ref":"#/$defs/cel"},"kind":{"enum":["alpha","color"]},"threshold":{"type":"integer","minimum":1,"maximum":255},"color":{"$ref":"#/$defs/color"},"match":{"enum":["rgb","rgba"]},"replace":{"type":"boolean"}},"required":["op","source","target"],"additionalProperties":false,"x-priority":"Core"},
    "op_noise": {"type":"object","properties":{"op":{"const":"noise"},"targets":{"$ref":"#/$defs/targets"},"region":{"$ref":"#/$defs/rect"},"mask":{"$ref":"#/$defs/cel"},"clip":{"type":"boolean"},"seed":{"type":"string","pattern":"^[0-9A-Fa-f]{16}$"},"colors":{"type":"array","items":{"$ref":"#/$defs/color"},"minItems":1,"maxItems":256},"density":{"type":"integer","minimum":0,"maximum":1000}},"required":["op","targets","seed","colors","density"],"additionalProperties":false,"x-priority":"Core"},
    "op_anchor_set": {"type":"object","properties":{"op":{"const":"anchor.set"},"targets":{"type":"array","items":{"$ref":"#/$defs/ref2"},"minItems":1,"maxItems":4096,"uniqueItems":true},"name":{"$ref":"#/$defs/name"},"at":{"$ref":"#/$defs/point"}},"required":["op","targets","name","at"],"additionalProperties":false,"x-priority":"Core"},
    "op_clip_set": {"type":"object","properties":{"op":{"const":"clip.set"},"asset":{"$ref":"#/$defs/name"},"name":{"$ref":"#/$defs/name"},"frames":{"type":"array","items":{"$ref":"#/$defs/name"},"minItems":1,"maxItems":16384},"direction":{"$ref":"#/$defs/name"},"playback":{"enum":["forward","reverse","pingpong"]},"repeat":{"type":"integer","minimum":0,"maximum":65535},"replace":{"type":"boolean"}},"required":["op","asset","name","frames"],"additionalProperties":false,"x-priority":"Core"},
    "op_style_set": {"type":"object","properties":{"op":{"const":"style.set"},"name":{"$ref":"#/$defs/name"},"size":{"$ref":"#/$defs/size"},"palette":{"$ref":"#/$defs/name"},"alpha":{"enum":["any","binary","opaque"]},"anchors":{"type":"array","items":{"$ref":"#/$defs/name"},"minItems":0,"maxItems":64,"uniqueItems":true},"nonempty":{"type":"boolean"},"replace":{"type":"boolean"}},"required":["op","name"],"additionalProperties":false,"x-priority":"Core"},
    "op_component_transfer": {"type":"object","properties":{"op":{"const":"component.transfer"},"project":{"type":"string","maxLength":65536},"source":{"$ref":"#/$defs/name"},"name":{"$ref":"#/$defs/name"}},"required":["op","project","source","name"],"additionalProperties":false,"x-priority":"Core"},
    "op_sheet_import": {"type":"object","properties":{"op":{"const":"sheet.import"},"asset":{"$ref":"#/$defs/name"},"layer":{"$ref":"#/$defs/name"},"file":{"type":"string","maxLength":65536},"size":{"$ref":"#/$defs/size"},"names":{"type":"array","items":{"$ref":"#/$defs/name"},"minItems":1,"maxItems":4096,"uniqueItems":true},"durations_ms":{"type":"array","items":{"type":"integer","minimum":1,"maximum":60000},"minItems":1,"maxItems":4096},"columns":{"type":"integer","minimum":1,"maximum":4096},"padding":{"type":"integer","minimum":0,"maximum":64}},"required":["op","asset","layer","file","size","names","columns"],"additionalProperties":false,"x-priority":"Core"},
    "op_meta_set": {"type":"object","properties":{"op":{"const":"meta.set"},"scope":{"enum":["project","asset","frame"]},"target":{"anyOf":[{"$ref":"#/$defs/name"},{"$ref":"#/$defs/ref2"}]},"key":{"$ref":"#/$defs/name"},"value":{"type":"string","maxLength":65536},"replace":{"type":"boolean"}},"required":["op","scope","key","value"],"additionalProperties":false,"x-priority":"Foundation"},
    "op_object_delete": {"type":"object","properties":{"op":{"const":"object.delete"},"kind":{"enum":["asset","layer","frame","cel","clip","anchor","palette","style","meta"]},"target":{"type":"string","maxLength":259},"scope":{"enum":["project","asset","frame"]},"key":{"$ref":"#/$defs/name"},"cascade":{"type":"boolean"}},"required":["op","kind"],"additionalProperties":false,"x-priority":"Core"},
    "operation": {"oneOf":[{"$ref":"#/$defs/op_asset_create"},{"$ref":"#/$defs/op_asset_clone"},{"$ref":"#/$defs/op_asset_set"},{"$ref":"#/$defs/op_layer_create"},{"$ref":"#/$defs/op_layer_set"},{"$ref":"#/$defs/op_frame_create"},{"$ref":"#/$defs/op_frame_set"},{"$ref":"#/$defs/op_cel_create"},{"$ref":"#/$defs/op_cel_offset"},{"$ref":"#/$defs/op_png_import"},{"$ref":"#/$defs/op_grid"},{"$ref":"#/$defs/op_draw"},{"$ref":"#/$defs/op_fill"},{"$ref":"#/$defs/op_stamp"},{"$ref":"#/$defs/op_transform"},{"$ref":"#/$defs/op_palette_set"},{"$ref":"#/$defs/op_palette_extract"},{"$ref":"#/$defs/op_palette_map"},{"$ref":"#/$defs/op_palette_quantize"},{"$ref":"#/$defs/op_alpha"},{"$ref":"#/$defs/op_mask_create"},{"$ref":"#/$defs/op_noise"},{"$ref":"#/$defs/op_anchor_set"},{"$ref":"#/$defs/op_clip_set"},{"$ref":"#/$defs/op_style_set"},{"$ref":"#/$defs/op_component_transfer"},{"$ref":"#/$defs/op_sheet_import"},{"$ref":"#/$defs/op_meta_set"},{"$ref":"#/$defs/op_object_delete"}]},
    "export": {"type":"object","properties":{"name":{"$ref":"#/$defs/name"},"kind":{"enum":["frame","sheet","frames","contact","diff","onion"]},"targets":{"$ref":"#/$defs/frameTargets"},"scale":{"type":"integer","minimum":1,"maximum":16},"allow_clip":{"type":"boolean"},"components":{"type":"boolean"},"columns":{"type":"integer","minimum":1,"maximum":4096},"padding":{"type":"integer","minimum":0,"maximum":64},"extrude":{"type":"integer","minimum":0,"maximum":16},"clips":{"type":"array","items":{"$ref":"#/$defs/ref2"},"minItems":0,"maxItems":4096,"uniqueItems":true}},"required":["name","kind","targets"],"additionalProperties":false},
    "exportsRequest": {"type":"object","properties":{"interface":{"const":1},"semantics":{"const":"1.0"},"exports":{"type":"array","items":{"$ref":"#/$defs/export"},"minItems":1,"maxItems":4096}},"required":["interface","semantics","exports"],"additionalProperties":false},
    "inspectQuery": {"type":"object","properties":{"target":{"anyOf":[{"$ref":"#/$defs/ref2"},{"$ref":"#/$defs/cel"}]},"region":{"$ref":"#/$defs/rect"},"pixels":{"type":"boolean"},"symbols":{"type":"boolean"},"against":{"type":"object","properties":{"project":{"type":"string","maxLength":65536},"target":{"anyOf":[{"$ref":"#/$defs/ref2"},{"$ref":"#/$defs/cel"}]}},"required":["project","target"],"additionalProperties":false},"histogram_limit":{"type":"integer","minimum":1,"maximum":256}},"required":[],"additionalProperties":false},
