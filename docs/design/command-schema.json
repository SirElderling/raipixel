{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "raipixel proposed job interface 1",
  "description": "Documentation contract only. Structural validation; cross-field/reference/pixel rules in 06-agent-interface.md. Foundation/Core field availability is reported by each future binary.",
  "type": "object",
  "properties": {
    "interface": {
      "const": 1
    },
    "semantics": {
      "const": "1.0"
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "checks": {
      "$ref": "#/$defs/checks"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "interface",
    "semantics",
    "ops"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "ref2": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}/[A-Za-z][A-Za-z0-9_-]{0,63}$"},
