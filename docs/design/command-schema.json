    "op_transform": {"type":"object","properties":{"op":{"const":"transform"},"targets":{"$ref":"#/$defs/targets"},"kind":{"enum":["flip-x","flip-y","rotate-90","rotate-180","rotate-270","scale","reduce","crop"]},"factor":{"type":"integer","minimum":1,"maximum":16},"grid":{"$ref":"#/$defs/size"},"phase":{"$ref":"#/$defs/point"},"rect":{"$ref":"#/$defs/rect"}},"required":["op","targets","kind"],"additionalProperties":false,"x-priority":"Core"},
