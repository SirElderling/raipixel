    "color": {"type":"string","pattern":"^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|@[A-Za-z][A-Za-z0-9_-]{0,63}/[A-Za-z][A-Za-z0-9_-]{0,63})$"},
    "rgb": {"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},
    "literal": {"type":"string","pattern":"^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"},
    "point": {"type":"array","items":{"type":"integer","minimum":-2147483648,"maximum":2147483647},"minItems":2,"maxItems":2},
    "size": {"type":"array","items":{"type":"integer","minimum":1,"maximum":4096},"minItems":2,"maxItems":2},
    "rect": {"type":"array","prefixItems":[{"type":"integer","minimum":-2147483648,"maximum":2147483647},{"type":"integer","minimum":-2147483648,"maximum":2147483647},{"type":"integer","minimum":1,"maximum":4096},{"type":"integer","minimum":1,"maximum":4096}],"items":false,"minItems":4,"maxItems":4},
    "targets": {"type":"array","items":{"$ref":"#/$defs/cel"},"minItems":1,"maxItems":4096,"uniqueItems":true},
    "frameTargets": {"type":"array","items":{"$ref":"#/$defs/ref2"},"minItems":1,"maxItems":4096},
